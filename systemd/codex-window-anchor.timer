# Managed-By: codex-window-anchor

[Unit]
Description=Codex Window Anchor Schedule
Documentation=https://github.com/LHann79357/codex-window-anchor

[Timer]

# Reference schedule from the original validated deployment.
#
# IMPORTANT:
# Review and customize the timezone and schedule before enabling this timer.
#
# More Anchor runs mean more real Codex requests.
# They do NOT create additional quota.

OnCalendar=*-*-* 08:00:00 Asia/Shanghai
OnCalendar=*-*-* 13:05:00 Asia/Shanghai
OnCalendar=*-*-* 18:10:00 Asia/Shanghai

AccuracySec=30s
RandomizedDelaySec=0
Persistent=false

Unit=codex-window-anchor.service

[Install]
WantedBy=timers.target
